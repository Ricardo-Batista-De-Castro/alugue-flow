generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senha     String
  tipo      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pessoa Pessoa?

  @@map("usuario")
}

model Imovel {
  id          String   @id @default(uuid())
  nome        String
  endereco    String
  numero      String
  complemento String?
  bairro      String
  cidade      String
  estado      String
  cep         String
  tipo        String
  quartos     Int?
  banheiros   Int?
  garagens    Int?
  area        Float?
  valorAluguel Float?
  status      String   @default("disponivel")
  observacoes String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contratos Contrato[]

  @@index([status])
  @@map("imovel")
}

model Pessoa {
  id          String   @id @default(uuid())
  nome        String
  cpf         String   @unique
  rg          String?
  telefone    String
  email       String   @unique
  profissao   String?
  rendaMensal Float?
  endereco    String?
  dataNascimento DateTime? @db.Date 
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  usuarioId String?   @unique
  usuario   Usuario?  @relation(fields: [usuarioId], references: [id])

  contratos Contrato[]

  @@map("pessoa")
}

model Contrato {
  id             String   @id @default(uuid())
  dataInicio     DateTime
  dataFim        DateTime
  valorAluguel   Float
  diaVencimento  Int
  status         String   @default("ativo")
  observacoes    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  imovelId    String
  imovel      Imovel     @relation(fields: [imovelId], references: [id])

  pessoaId String
  pessoa   Pessoa  @relation(fields: [pessoaId], references: [id])

  pagamentos  Pagamento[]

  @@index([imovelId])
  @@index([pessoaId])
  @@index([status])
  @@index([imovelId, status])
  @@index([pessoaId, status])
  @@map("contrato")
}

model Pagamento {
  id              String   @id @default(uuid())
  dataVencimento  DateTime
  dataPagamento   DateTime?
  valorPago       Float?
  status          String   @default("pendente")
  observacoes     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contratoId String
  contrato   Contrato @relation(fields: [contratoId], references: [id])

  @@index([contratoId])
  @@index([dataVencimento])
  @@index([status])
  @@index([contratoId, status])
  @@map("pagamento")
}
